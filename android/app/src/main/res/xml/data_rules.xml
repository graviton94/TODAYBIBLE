<?xml version="1.0" encoding="utf-8"?>
<!-- 구글 계정 백업 · 새 폰으로 옮기기 (안드로이드 12+): 기록 · 발자취 · 설정. 손글씨(획이라 작음)까지. 목소리는 기기 간 옮기기에만 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="fills.tsv" />
        <include domain="file" path="earned.tsv" />
        <include domain="file" path="marks.tsv" />
        <include domain="file" path="ink/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
